# Production environment. Copy to `.env.production` and edit:
#
#   cp .env.production.example .env.production
#
# That file is gitignored. Never commit it, and never paste a real key into this
# example — that is the one mistake here that cannot be undone by rotating it.


# ---------------------------------------------------------------------------------
# Required. There is no default for any of these, and the stack refuses to start
# without them rather than coming up in a broken state.
# ---------------------------------------------------------------------------------

# The address users visit. Caddy issues its certificate for this name, and it is
# what every link in an outgoing email is built from — a wrong value here is the
# difference between a working reset link and one that goes nowhere.
APP_URL=https://arezoo.example

# The domain, and the address Let's Encrypt should contact about expiry. ACME_EMAIL
# is a real address you read: it is where expiry warnings go.
DOMAIN=arezoo.example
ACME_EMAIL=you@yourdomain.com

# Generate with:
#   docker compose -f compose.production.yaml run --rm app php artisan key:generate --show
# Then paste the output here, without the surrounding quotes. It encrypts sessions,
# signs the password-reset and verification URLs, and protects anything else using
# the encrypter. Rotating it invalidates every session and every outstanding reset
# link, which is the correct behaviour and still an inconvenience.
APP_KEY=

# Passwords for the database. Generate real ones:
#   openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_DATABASE=arezoo
DB_USERNAME=arezoo


# ---------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------

APP_NAME=Arezoo
APP_ENV=production
# False. With this on, an exception shows a stack trace and an environment dump to
# whoever triggered it — including your database password.
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

# Laravel needs to know that X-Forwarded-Proto is trustworthy, so that a request
# which arrived over HTTPS is not recorded as plain HTTP — which would drop the
# Secure flag from session cookies and put http:// in password-reset emails.
#
# This is not configured here. It is `trustProxies(at: '*')` in bootstrap/app.php,
# because the only thing in front of the app in this topology is Caddy, over the
# internal Docker network, where no visitor can set a header. There is deliberately
# no environment variable for it: a trusted-proxy list that a deploy could widen to
# `*` from a settings file would make spoofing the scheme a one-line change.


# ---------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------

DB_CONNECTION=mariadb
# DB_HOST is set by compose.production.yaml to the service name. It is not repeated
# here, because the same value would then exist in two places to disagree.


# ---------------------------------------------------------------------------------
# Session, cache, queue
# ---------------------------------------------------------------------------------

# The database, which means a session survives a deploy and needs no Redis. Fine at
# this application's scale; the migration to Redis is a change of these two lines.
SESSION_DRIVER=database
# The cookie is only sent over HTTPS. Safe because TLS terminates at Caddy, and it
# would be actively wrong without it: the cookie would go out in the clear on any
# request that arrived over plain HTTP.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Sessions and cache both in the database means every page view is at least two
# queries. If the site ever feels slow under real traffic, this is the first thing
# to move, and Redis is the destination.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
# Single file inside a container that is replaced on every deploy, so it dies with
# the container. Caddy's access log goes to stdout, which `docker compose logs`
# shows without anyone having to go looking.
LOG_DAILY_DAYS=7


# ---------------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------------
#
# READ THIS BEFORE LAUNCHING.
#
# Signup is unusable until this is real. A new account must confirm its address
# before it can be used, and the confirmation arrives by email. With the log driver,
# nothing is sent: the user is told to check an inbox, and there is no inbox. The
# failure is silent and it is total — every registration stalls at the same point.
#
# Until a provider is chosen, leave this as `log` to read what would have been sent
# (`docker compose exec app tail -f storage/logs/laravel.log`), or start Mailpit
# with `--profile mail` and read it at http://127.0.0.1:8025. Neither delivers
# anything. Both are ways of seeing the message, not ways of sending it.
#
# It ships as `log` on purpose. The example below is commented out rather than
# active, because a half-configured SMTP host fails differently from a log
# driver — and a silent signup failure is the failure mode this section exists to
# prevent. Uncomment it once a real server answers on that host and port.
MAIL_MAILER=log

# --- a self-hosted server -------------------------------------------------------
#
# Works whether that server is a separate VPS or the same host as the application,
# because mail.domain.com resolves to it either way. It must be a name, not
# 127.0.0.1: inside a container, the loopback address is that container, so a
# loopback host would send mail to the application itself.
#
# Port 587 is submission and expects STARTTLS, which is what MAIL_SCHEME=tls means.
# Port 465 is the implicit-TLS alternative and would need MAIL_SCHEME=smtps.
#
# Use a dedicated mailbox for the application, and an app-specific password if the
# server offers them, so that rotating it never requires touching a person's
# account. See docs/mail-server.md.
#
# MAIL_MAILER=smtp
# MAIL_HOST=mail.arezoo.example
# MAIL_PORT=587
# MAIL_USERNAME=arezoo@arezoo.example
# MAIL_PASSWORD=
# MAIL_SCHEME=tls

# --- a hosted provider, if that changes later -----------------------------------
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.postmarkapp.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_TIMEOUT=10
# The address mail claims to come from. This must be a domain whose SPF and DKIM
# records you control, and it must match the MAIL_USERNAME domain — a mismatch
# between the two fails authentication at the receiving end, so the message is
# either rejected or filed as spam.
MAIL_FROM_ADDRESS=hello@arezoo.example
MAIL_FROM_NAME="${APP_NAME}"


# ---------------------------------------------------------------------------------
# Not needed in production
# ---------------------------------------------------------------------------------

# SSR is off. Turning it on means building a bundle (`bun run build:ssr`) and
# running a process to serve it — see config/inertia.php.
INERTIA_SSR_ENABLED=false

# The development mail service. Unused here; present so that a Mailpit-based
# workflow does not silently point at a production host.
MAILPIT_API_URL=http://127.0.0.1:8025
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
