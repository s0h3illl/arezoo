APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# The compose stack replaces this block with MySQL (docker/compose.yaml sets the
# DB_* values as real environment variables, which the dotenv loader does not
# overwrite), so a containerised run never has to edit this file.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
# Mailpit's own SMTP port. It is 1025 rather than the 2525 Laravel's skeleton ships,
# because 1025 is the port the image listens on and matching it means the same two
# numbers work whether Mailpit runs in the compose stack or natively.
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Bounds how long the SMTP transport waits. With no mail service listening this
# turns a 60 second hang into a 10 second failure. Set MAIL_MAILER=failover to fall
# back to the log driver instead of failing, when running without Mailpit at all.
MAIL_TIMEOUT=10

# The development mail service (docker/compose.yaml). The SMTP host/port above is
# where the application hands mail over; the API url is where tests read it back.
# Compose sets all three as real environment variables — to the service names
# `mailpit`, which is what resolves between containers — so these loopback values
# are only reached by a run outside Docker.
MAILPIT_API_URL=http://127.0.0.1:8025
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The Inertia SSR server is started by the dev server, so inside the compose stack it
# lives in another container and is reached by service name. Left unset, the loopback
# default in config/inertia.php is correct for a single-machine run.
# INERTIA_SSR_URL=http://vite:13714
